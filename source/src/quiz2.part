 [['بر الوالدين','Kindness to parents'],'heart',[
  ['كيف نكلم والدينا؟','How do we speak to our parents?',['بأدب ولطف','Politely and gently'],['بصوت مرتفع','Loudly'],['لا نكلمهم','We do not talk to them']],
